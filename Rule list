ruleset=🎯 全球直连,[]GEOIP,CN
ruleset=🐟 漏网之鱼,[]FINAL


; ================= 2. 策略分组定义 =================

; 主代理组（仅包含普通倍率节点，高倍节点放入手动选择备用）
custom_proxy_group=🚀 节点选择`select`[]♻️ 自动选择`[]🇸🇬 狮城节点-自动`[]🇹🇼 台湾节点-自动`[]🇲🇾 大马节点-自动`[]🇯🇵 日本节点-自动`[]🇺🇲 美国节点-自动`[]🇭🇰 香港节点-自动`[]⚡ 高倍应急`[]🚀 手动切换`[]DIRECT
custom_proxy_group=🚀 手动切换`select`.*
custom_proxy_group=⚡ 高倍应急`select`(.*(?:高倍|[2-9]x|[1-9][0-9]x|[2-9]倍|[1-9][0-9]倍).*$)

; 全局自动选择（严格排除高倍节点和3x流量）
custom_proxy_group=♻️ 自动选择`url-test`(^(?!.*(?:高倍|[2-9]x|[1-9][0-9]x|[2-9]倍|[1-9][0-9]倍))(?=.*(?:港|香港|HongKong|HK|台|新北|彰化|TW|Taiwan|新加坡|坡|狮城|SG|Singapore|日本|川日|东京|大阪|JP|Japan|美|美国|United States|US|USA|马来|大马|MY|Malaysia)).*$)`http://www.gstatic.com/generate_204`300,100

; ---------- 地区自动测速组 (全部加装排除高倍防线) ----------
custom_proxy_group=🇸🇬 狮城节点-自动`url-test`(^(?!.*(?:高倍|[2-9]x|[1-9][0-9]x|[2-9]倍|[1-9][0-9]倍))(?=.*(?:新加坡|坡|狮城|SG|Singapore)).*$)`http://www.gstatic.com/generate_204`300,100
custom_proxy_group=🇹🇼 台湾节点-自动`url-test`(^(?!.*(?:高倍|[2-9]x|[1-9][0-9]x|[2-9]倍|[1-9][0-9]倍))(?=.*(?:台|新北|彰化|TW|Taiwan)).*$)`http://www.gstatic.com/generate_204`300,100
custom_proxy_group=🇲🇾 大马节点-自动`url-test`(^(?!.*(?:高倍|[2-9]x|[1-9][0-9]x|[2-9]倍|[1-9][0-9]倍))(?=.*(?:马来|大马|MY|Malaysia)).*$)`http://www.gstatic.com/generate_204`300,100
custom_proxy_group=🇯🇵 日本节点-自动`url-test`(^(?!.*(?:高倍|[2-9]x|[1-9][0-9]x|[2-9]倍|[1-9][0-9]倍))(?=.*(?:日本|川日|东京|大阪|泉日|埼玉|沪日|深日|JP|Japan)).*$)`http://www.gstatic.com/generate_204`300,100
custom_proxy_group=🇺🇲 美国节点-自动`url-test`(^(?!.*(?:高倍|[2-9]x|[1-9][0-9]x|[2-9]倍|[1-9][0-9]倍))(?=.*(?:美|美国|United States|(?<![a-zA-Z])US(?![a-zA-Z])|(?<![a-zA-Z])USA(?![a-zA-Z]))).*$)`http://www.gstatic.com/generate_204`300,100
custom_proxy_group=🇭🇰 香港节点-自动`url-test`(^(?!.*(?:高倍|[2-9]x|[1-9][0-9]x|[2-9]倍|[1-9][0-9]倍))(?=.*(?:港|香港|HongKong|HK|Hong Kong)).*$)`http://www.gstatic.com/generate_204`300,100

; ---------- AI / Gemini 专属策略组 ----------
; 绝对不放入香港节点，首选机场提示支持的新加坡、马来西亚、美国、台湾优质普通节点
custom_proxy_group=🤖 Gemini/AI`select`[]🇸🇬 狮城节点-自动`[]🇲🇾 大马节点-自动`[]🇺🇲 美国节点-自动`[]🇹🇼 台湾节点-自动`[]🇯🇵 日本节点-自动`[]⚡ 高倍应急`[]🚀 手动切换

