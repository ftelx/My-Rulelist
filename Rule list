[custom]
;acl4SSR PC端专属优化配置
;分流次序：局域网 -> 广告/隐私拦截 -> 自定义直连 -> 特定外网服务 -> 基础外网代理 -> 国内直连 -> GEOIP -> 漏网之鱼

enable_rule_generator=true
overwrite_original_rules=true
skip_failed_links=true

; ================= 1. 规则集定义 (严格自顶向下执行) =================

; [局域网与基础直连] 最优先匹配，杜绝内网设备和本地服务走代理
ruleset=🎯 全球直连,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/LocalAreaNetwork.list
ruleset=🎯 全球直连,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/UnBan.list

; [广告与隐私拦截] 提前拦截，防止广告域名被国内直连规则优先放行
ruleset=🛑 广告拦截,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/BanAD.list
ruleset=🛑 广告拦截,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/BanProgramAD.list
ruleset=🆎 AdBlock,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/BanEasyList.list
ruleset=🆎 AdBlock,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/BanEasyListChina.list
ruleset=🛡️ 隐私防护,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/BanEasyPrivacy.list

; [个人自定义直连]
ruleset=🎯 全球直连,https://raw.githubusercontent.com/ftelx/My-Rulelist/main/Direct.list

; [谷歌国内服务] Chrome更新、部分直连字体与API
ruleset=🎯 全球直连,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/GoogleCN.list

; [特定海外服务]
ruleset=🤖 OpenAI,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/rule/Clash/OpenAI/OpenAI.list
ruleset=Github,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/GitHub/GitHub.list
ruleset=📲 Telegram,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/Telegram.list
ruleset=📹 YouTube,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/rule/Clash/YouTube/YouTube.list
ruleset=🔍 Google,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/rule/Clash/Google/Google.list
ruleset=🎥 Netflix,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/Ruleset/Netflix.list
ruleset=🎥 Netflix,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/Ruleset/NetflixIP.list
ruleset=🎵 TikTok,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/Ruleset/TikTok.list
ruleset=🎼 Spotify,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/rule/Clash/Spotify/Spotify.list

; [游戏服务] 商店登录走代理，大流量CDN下载直连跑满宽带
ruleset=🎮 Steam,https://raw.githubusercontent.com/ftelx/My-Rulelist/main/Steam.list
ruleset=🎮 Epic,https://raw.githubusercontent.com/ftelx/My-Rulelist/main/Epic.list
ruleset=🎯 全球直连,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/Ruleset/SteamCN.list

; [系统服务]
ruleset=Ⓜ️ 微软服务,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Microsoft/Microsoft.list
ruleset=🍎 苹果服务,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/Apple.list

; [国外基础代理规则] 兜底收录普通海外网站（Twitter/Reddit/Discord等），避免未配置服务被判直连
ruleset=🌍 国外媒体,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/ProxyMedia.list
ruleset=🚀 节点选择,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/ProxyLite.list

; [国内服务与媒体]
ruleset=📺 Bilibili,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/Ruleset/Bilibili.list
ruleset=📺 Bilibili,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/Ruleset/BilibiliHMT.list
ruleset=🌏 国内媒体,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/ChinaMedia.list
ruleset=🎯 全球直连,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/ChinaDomain.list
ruleset=🎯 全球直连,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/ChinaCompanyIp.list
ruleset=🎯 全球直连,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/Download.list

; [兜底直连与漏网之鱼]
ruleset=🎯 全球直连,[]GEOIP,CN
ruleset=🐟 漏网之鱼,[]FINAL


; ================= 2. 策略分组定义 =================

; 主代理组
custom_proxy_group=🚀 节点选择`select`[]🇺🇲 美国节点-自动`[]🇯🇵 日本节点-自动`[]🇭🇰 香港节点-自动`[]♻️ 自动选择`[]🔯 故障转移`[]🚀 手动切换`[]DIRECT
custom_proxy_group=🚀 手动切换`select`.*
custom_proxy_group=♻️ 自动选择`url-test`((^(?!.*x(?:[2-9]|[1-9][0-9]))(?=.*(?:港|香港|HongKong|HK|Hong Kong|台|新北|彰化|TW|Taiwan|新加坡|坡|狮城|SG|Singapore|日本|川日|东京|大阪|泉日|埼玉|沪日|深日|JP|Japan|美|美国|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|United States|(?<![a-zA-Z])US(?![a-zA-Z])|(?<![a-zA-Z])USA(?![a-zA-Z])|(?<![a-zA-Z])USD(?![a-zA-Z])|KR|Korea|KOR|首尔|韩|韓)).*$))`http://www.gstatic.com/generate_204`300,100
custom_proxy_group=🔯 故障转移`fallback`.*`http://www.gstatic.com/generate_204`300,100

; 地区自动测速组 (修复美国组双逗号错误，容差设置为150ms)
custom_proxy_group=🇺🇲 美国节点-自动`url-test`(^(?!.*x(?:[2-9]|[1-9][0-9]))(?=.*(?:美|美国|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|United States|(?<![a-zA-Z])US(?![a-zA-Z])|(?<![a-zA-Z])USA(?![a-zA-Z])|(?<![a-zA-Z])USD(?![a-zA-Z]))).*$)`http://www.gstatic.com/generate_204`300,150
custom_proxy_group=🇯🇵 日本节点-自动`url-test`(^(?!.*x(?:[2-9]|[1-9][0-9]))(?=.*(?:日本|川日|东京|大阪|泉日|埼玉|沪日|深日|JP|Japan)).*$)`http://www.gstatic.com/generate_204`300,100
custom_proxy_group=🇭🇰 香港节点-自动`url-test`(^(?!.*x(?:[2-9]|[1-9][0-9]))(?=.*(?:港|香港|HongKong|HK|Hong Kong)).*$)`http://www.gstatic.com/generate_204`300,100
custom_proxy_group=🇨🇳 台湾节点-自动`url-test`(^(?!.*x(?:[2-9]|[1-9][0-9]))(?=.*(?:台|新北|彰化|TW|Taiwan)).*$)`http://www.gstatic.com/generate_204`300,100
custom_proxy_group=🇸🇬 狮城节点-自动`url-test`(^(?!.*x(?:[2-9]|[1-9][0-9]))(?=.*(?:新加坡|坡|狮城|SG|Singapore)).*$)`http://www.gstatic.com/generate_204`300,100
custom_proxy_group=🇰🇷 韩国节点-自动`url-test`(^(?!.*x(?:[2-9]|[1-9][0-9]))(?=.*(?:KR|Korea|KOR|首尔|韩|韓)).*$)`http://www.gstatic.com/generate_204`300,100

; 服务分流组 (根据可用节点实际情况优化：OpenAI剔除香港节点，首选美国/日本)
custom_proxy_group=🤖 OpenAI`select`[]🇺🇲 美国节点-自动`[]🇯🇵 日本节点-自动`[]🇸🇬 狮城节点-自动`[]🇨🇳 台湾节点-自动`[]🚀 手动切换
custom_proxy_group=Github`select`[]🇺🇲 美国节点-自动`[]🇯🇵 日本节点-自动`[]🇭🇰 香港节点-自动`[]🚀 节点选择`[]DIRECT
custom_proxy_group=📲 Telegram`select`[]🇺🇲 美国节点-自动`[]🇯🇵 日本节点-自动`[]🇭🇰 香港节点-自动`[]🚀 节点选择
custom_proxy_group=📹 YouTube`select`[]🚀 节点选择`[]🇺🇲 美国节点-自动`[]🇯🇵 日本节点-自动`[]🇭🇰 香港节点-自动
custom_proxy_group=🔍 Google`select`[]🚀 节点选择`[]🇺🇲 美国节点-自动`[]🇯🇵 日本节点-自动`[]🇭🇰 香港节点-自动
custom_proxy_group=🎼 Spotify`select`[]DIRECT`[]🚀 节点选择`[]🇺🇲 美国节点-自动`[]🇯🇵 日本节点-自动
custom_proxy_group=🎵 TikTok`select`[]🇺🇲 美国节点-自动`[]🇯🇵 日本节点-自动`[]🇨🇳 台湾节点-自动
custom_proxy_group=🎥 Netflix`select`[]🇺🇲 美国节点-自动`[]🇯🇵 日本节点-自动`[]🇭🇰 香港节点-自动`[]🇨🇳 台湾节点-自动
custom_proxy_group=🌍 国外媒体`select`[]🚀 节点选择`[]🇺🇲 美国节点-自动`[]🇯🇵 日本节点-自动`[]🇭🇰 香港节点-自动

; 游戏服务策略
custom_proxy_group=🎮 Steam`select`[]DIRECT`[]🚀 节点选择`[]🇭🇰 香港节点-自动`[]🇯🇵 日本节点-自动`[]🇺🇲 美国节点-自动
custom_proxy_group=🎮 Epic`select`[]DIRECT`[]🚀 节点选择`[]🇭🇰 香港节点-自动`[]🇯🇵 日本节点-自动`[]🇺🇲 美国节点-自动

; 平台服务与媒体
custom_proxy_group=📺 Bilibili`select`[]DIRECT`[]🇨🇳 台湾节点-自动`[]🇭🇰 香港节点-自动
custom_proxy_group=🌏 国内媒体`select`[]DIRECT`[]🇭🇰 香港节点-自动`[]🇨🇳 台湾节点-自动
custom_proxy_group=Ⓜ️ 微软服务`select`[]DIRECT`[]🚀 节点选择`[]🇭🇰 香港节点-自动`[]🇺🇲 美国节点-自动
custom_proxy_group=🍎 苹果服务`select`[]DIRECT`[]🚀 节点选择`[]🇭🇰 香港节点-自动`[]🇺🇲 美国节点-自动

; 基础防护与控制
custom_proxy_group=🎯 全球直连`select`[]DIRECT`[]🚀 节点选择
custom_proxy_group=🛑 广告拦截`select`[]REJECT`[]DIRECT
custom_proxy_group=🆎 AdBlock`select`[]REJECT`[]DIRECT
custom_proxy_group=🛡️ 隐私防护`select`[]REJECT`[]DIRECT

; 漏网之鱼：优先代理，避免未列出的国外网站打不开；如遇国内网站误走代理可切回 DIRECT
custom_proxy_group=🐟 漏网之鱼`select`[]🚀 节点选择`[]DIRECT`[]🇺🇲 美国节点-自动`[]🇯🇵 日本节点-自动


